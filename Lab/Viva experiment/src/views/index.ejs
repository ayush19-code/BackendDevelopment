<%- include('partials/header') %>

<section class="hero-section">
  <div class="hero-content">
    <h1 class="page-title">Blog Posts</h1>
    <p class="page-subtitle">Explore latest articles and insights created by our community.</p>
  </div>
  <a href="/posts/new" class="btn btn-primary btn-large">+ Create New Post</a>
</section>

<% if (posts.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">📭</div>
    <h2>No blog posts yet</h2>
    <p>Be the first to publish a post on Simple CMS!</p>
    <a href="/posts/new" class="btn btn-primary">Create Post Now</a>
  </div>
<% } else { %>
  <div class="posts-grid">
    <% posts.forEach(function(post) { %>
      <article class="post-card">
        <div class="post-card-body">
          <h2 class="post-title">
            <a href="/posts/<%= post._id %>" class="post-title-link">
              <%= post.title %>
            </a>
          </h2>
          <div class="post-meta">
            <span class="post-author">By <strong><%= post.author %></strong></span>
            <span class="meta-divider">•</span>
            <span class="post-date"><%= post.formattedDate %></span>
          </div>
        </div>
        <div class="post-card-footer">
          <a href="/posts/<%= post._id %>" class="read-more-link">Read Full Post &rarr;</a>
          <form action="/posts/<%= post._id %>/delete" method="POST" class="delete-form" onsubmit="return confirm('Are you sure you want to delete this post?');">
            <button type="submit" class="btn-icon-delete" title="Delete Post">🗑️</button>
          </form>
        </div>
      </article>
    <% }); %>
  </div>
<% } %>

<%- include('partials/footer') %>
