<%- include('partials/header') %>

<div class="form-container">
  <div class="form-header">
    <a href="/posts" class="back-link">&larr; Back to Posts</a>
    <h1 class="form-title">Create New Blog Post</h1>
    <p class="form-description">Fill in the details below to publish your blog post to MongoDB.</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error">
      <span class="alert-icon">⚠️</span>
      <span class="alert-text"><%= error %></span>
    </div>
  <% } %>

  <form action="/posts" method="POST" class="post-form">
    <div class="form-group">
      <label for="title" class="form-label">Post Title <span class="required">*</span></label>
      <input 
        type="text" 
        id="title" 
        name="title" 
        class="form-input" 
        placeholder="e.g. Introduction to MongoDB" 
        value="<%= typeof formData !== 'undefined' ? formData.title : '' %>"
        required
      >
    </div>

    <div class="form-group">
      <label for="author" class="form-label">Author Name <span class="required">*</span></label>
      <input 
        type="text" 
        id="author" 
        name="author" 
        class="form-input" 
        placeholder="e.g. Rahul Sharma" 
        value="<%= typeof formData !== 'undefined' ? formData.author : '' %>"
        required
      >
    </div>

    <div class="form-group">
      <label for="content" class="form-label">Post Content <span class="required">*</span></label>
      <textarea 
        id="content" 
        name="content" 
        rows="8" 
        class="form-textarea" 
        placeholder="Write your blog post content here..." 
        required
      ><%= typeof formData !== 'undefined' ? formData.content : '' %></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary btn-submit">Publish Post</button>
      <a href="/posts" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
